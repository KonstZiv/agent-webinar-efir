# Змінні середовища застосунку — перелік без значень. Правила — src/app/settings.py; у проєкті — spec.md, розділ «Налаштування».
# [обов'язкова] — без неї застосунок не стартує; для необов'язкових у дужках — значення за замовчуванням.
# Порожнє значення вважається незаданим.

# З'єднання з PostgreSQL: postgresql://… (на Railway — посилання на змінну сервісу бази) [обов'язкова]
DATABASE_URL=

# Адреса іншого сайту для режиму переадресації: http(s)://вузол без шляху, параметрів і фрагмента.
# Непорожня — кожен запит, крім /healthz, отримує 307 на цю адресу з тим самим шляхом і параметрами (порожньо)
REDIRECT_BASE_URL=

# Індексація сайту пошуковиками: true | false (false — до запуску всі сторінки noindex)
INDEXING_ENABLED=

# Ідентифікатор вимірювання GA4; порожньо — аналітики немає і банер cookie сам не з'являється (порожньо)
GA4_MEASUREMENT_ID=

# Ключі Cloudflare Turnstile; потрібні маршрутові з формою, у шаблоні таких немає (порожньо)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Дозволені назви вузлів через кому; порожньо — не перевіряється (тестові ключі) (порожньо)
TURNSTILE_ALLOWED_HOSTNAMES=

# Ставить Railway: повне значення коміту; службова сторінка показує перші 7 символів
RAILWAY_GIT_COMMIT_SHA=
# Ставить Railway: порт, який слухає uvicorn (Procfile)
PORT=
