# Змінні середовища сайту v2 — перелік без значень. Правила — docs/requirements.md, розділ 14; перевірки — src/app/settings.py.
# [обов'язкова] — у звичайній роботі без неї застосунок не стартує; для необов'язкових у дужках — значення за замовчуванням.
# У режимі переадресації (задано REDIRECT_BASE_URL) досить DATABASE_URL і REDIRECT_BASE_URL.
# Порожнє значення вважається незаданим. [секрет] — значення лише в Railway і менеджері паролів.

# З'єднання з PostgreSQL: postgresql://… (на Railway — посилання на змінну сервісу бази) [обов'язкова завжди] [секрет]
DATABASE_URL=

# Адреса іншого сайту для режиму переадресації: http(s)://вузол без шляху, параметрів і фрагмента.
# Непорожня — кожен запит, крім /healthz, отримує 307 на цю адресу з тим самим шляхом і параметрами (порожньо)
REDIRECT_BASE_URL=

# Індексація сайту пошуковиками: true | false (false — до запуску всі сторінки noindex)
INDEXING_ENABLED=

# Ідентифікатор вимірювання GA4; порожньо — аналітики немає і банер cookie сам не з'являється (порожньо)
GA4_MEASUREMENT_ID=

# Ключі Cloudflare Turnstile [обов'язкові]; секретний ключ — [секрет], крім офіційного тестового на staging
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Дозволені повні назви сайтів через кому; порожньо — не перевіряється (тестові ключі) (порожньо)
TURNSTILE_ALLOWED_HOSTNAMES=

# Режим сайту: live | replay (live); інше значення — помилка під час запуску
SITE_MODE=
# Адреса сайту для посилань у листах, календарі й картці посилання: https://вузол [обов'язкова]
PUBLIC_BASE_URL=

# Початок і кінець вебінару — місцевий час Europe/Kyiv без зсуву, напр. 2026-10-21T19:00 [обов'язкові]
EVENT_START=
EVENT_END=
# Початок і кінець заняття 28.10 — місцевий час Europe/Kyiv без зсуву, напр. 2026-10-28T19:00 [обов'язкові]
LESSON_START=
LESSON_END=

# Адреса трансляції для /go/stream; порожньо — сторінка «посилання з'явиться» (порожньо)
STREAM_URL=
# Посилання на заняття в Teams для /go/lesson; не публікується; порожньо — сторінка «посилання з'явиться» (порожньо)
LESSON_URL=
# Сторінка курсу для /go/course: http(s)://… [обов'язкова]
COURSE_URL=
# Ідентифікатор відео запису на YouTube [обов'язкова в режимі replay]
RECORDING_YOUTUBE_ID=

# Ключ API Resend [обов'язкова] [секрет]
RESEND_API_KEY=
# Адреса відправника на домені mail.pythoncourse.me [обов'язкова]
SENDER_EMAIL=

# Секрет підпису посилань відписки, ≥ 32 символи; у продакшні — той самий, що у v1 [обов'язкова] [секрет]
UNSUBSCRIBE_SECRET=
# Токен адміністратора для заголовка Authorization: Bearer, ≥ 32 символи; не той, що у v1 [обов'язкова] [секрет]
ADMIN_TOKEN=

# Дозволені адреси реєстрації і пошти через кому, без «+» (варіанти з «+» дозволено автоматично);
# не публікується; порожньо — реєстрація відкрита (продакшн) (порожньо)
REGISTRATION_ALLOWLIST=

# Бот Telegram — чотири змінні разом або жодної; без них маршрут бота відповідає 404, а сайт працює (порожньо)
# Токен бота [секрет]
TELEGRAM_BOT_TOKEN=
# Ім'я бота без @ для посилання t.me/…
TELEGRAM_BOT_USERNAME=
# Секрет вебхука: 32–256 символів A-Z a-z 0-9 _ - [секрет]
TELEGRAM_WEBHOOK_SECRET=
# Канал для перевірки підписки: @назва
TELEGRAM_CHANNEL=
# Числовий ідентифікатор Telegram викладача: лише він керує чек-інами в боті; не секрет; порожньо — адмін-команди недоступні (порожньо)
TELEGRAM_ADMIN_USER_ID=

# Таємна частина адреси сторінки матеріалів /m/…: 8–32 символи A-Z a-z 0-9 _ -; не публікується; порожньо — 404 (порожньо)
MATERIALS_SLUG=

# LLM-чернетка бота (Issue Л): true | false (false); true вимагає ANTHROPIC_API_KEY
LLM_ENABLED=
# Ключ Claude API для Issue Л [секрет]
ANTHROPIC_API_KEY=

# Ставить Railway: повне значення коміту; сторінки підключають стилі й скрипти з ?v=<перші 7 символів>
RAILWAY_GIT_COMMIT_SHA=
# Ставить Railway: порт, який слухає uvicorn (Procfile)
PORT=
